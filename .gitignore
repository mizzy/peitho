/target
/dist
.peitho/
node_modules/
packages/peitho-present/node_modules/
packages/peitho-present/dist/*
!packages/peitho-present/dist/shell.js
!packages/peitho-present/dist/preview.js
!packages/peitho-present/dist/remote.js
/.demo-site
/.demo-site/deck-shots/
/.screenshots
site/static/giallo.css
site/static/deck-sources/
.zola-examples/
.worktrees/

# Project skills are versioned; local settings are not. A global ignore excludes
# .claude/, and Git cannot re-include files under an excluded directory, so the
# directory itself has to be re-included before narrowing again.
!.claude/
.claude/*
!.claude/skills/
